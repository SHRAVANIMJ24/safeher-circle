# Copy this file to application-local.properties and fill in real values.
# application-local.properties is git-ignored and must never be committed.

spring.datasource.password=YOUR_POSTGRES_PASSWORD

# Any random string of 32+ characters. Generate one with:
#   openssl rand -base64 48
safeher.jwt.secret=replace-me-with-a-long-random-string-at-least-32-chars
